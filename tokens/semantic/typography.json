{
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font.family.sans}",
        "$description": "All interface text."
      },
      "code": {
        "$value": "{font.family.mono}",
        "$description": "Code, IDs and other machine-readable values."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.regular}",
        "$description": "Running text."
      },
      "strong": {
        "$value": "{font.weight.semibold}",
        "$description": "Emphasis inside running text."
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Named text styles. Use as font: var(--text-*).",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.200}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}"
      },
      "$description": "Default for paragraphs, table cells and form values."
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.300}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}"
      },
      "$description": "Lead paragraphs and page introductions."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.200}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.tight}"
      },
      "$description": "Form labels, buttons, tabs and navigation."
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.100}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.snug}"
      },
      "$description": "Helper text, metadata and timestamps."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.200}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}"
      },
      "$description": "Inline code and identifiers."
    },
    "heading-1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.700}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}"
      },
      "$description": "The page title. One per page."
    },
    "heading-2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.600}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.tight}"
      },
      "$description": "Page sections and card titles."
    },
    "heading-3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.500}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}"
      },
      "$description": "Subsections."
    },
    "heading-4": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.400}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}"
      },
      "$description": "Small groups, card headers."
    }
  }
}
