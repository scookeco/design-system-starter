{
  "space": {
    "$type": "dimension",
    "gap": {
      "$description": "Space between siblings. Layout primitives take these as gap.",
      "2xs": {
        "$value": "{space.1}"
      },
      "xs": {
        "$value": "{space.2}"
      },
      "sm": {
        "$value": "{space.3}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.6}"
      },
      "xl": {
        "$value": "{space.8}"
      },
      "2xl": {
        "$value": "{space.12}"
      }
    },
    "inset": {
      "$description": "Padding inside a box.",
      "2xs": {
        "$value": "{space.half}"
      },
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.6}"
      },
      "xl": {
        "$value": "{space.8}"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Heights shared by buttons, inputs and selects.",
      "sm": {
        "$value": "{size.8}"
      },
      "md": {
        "$value": "{size.10}"
      },
      "lg": {
        "$value": "{size.12}"
      }
    },
    "icon": {
      "sm": {
        "$value": "{size.4}"
      },
      "md": {
        "$value": "{size.5}"
      },
      "$description": "Icon sizes: sm inline with body text and in controls, md beside larger text."
    },
    "target-min": {
      "$value": "{size.6}",
      "$description": "WCAG 2.2 minimum target size (24px)."
    },
    "content": {
      "$description": "Max measure for Center.",
      "xs": {
        "$value": "{container.md}",
        "$description": "Sign-in and other single-card pages."
      },
      "sm": {
        "$value": "{container.xl}"
      },
      "md": {
        "$value": "{container.3xl}"
      },
      "lg": {
        "$value": "{container.4xl}"
      }
    },
    "sidebar": {
      "$description": "Sidebar widths.",
      "sm": {
        "$value": "{container.3xs}"
      },
      "md": {
        "$value": "{container.2xs}"
      },
      "lg": {
        "$value": "{container.xs}"
      }
    },
    "rail": {
      "$value": "{size.12}",
      "$description": "Width of AppShell’s collapsed sidebar: the icon rail."
    },
    "grid-item": {
      "$description": "Minimum item width for auto-fit Grid.",
      "sm": {
        "$value": "{container.3xs}"
      },
      "md": {
        "$value": "{container.2xs}"
      },
      "lg": {
        "$value": "{container.xs}"
      }
    },
    "dialog": {
      "sm": {
        "$value": "{container.md}"
      },
      "md": {
        "$value": "{container.lg}"
      },
      "lg": {
        "$value": "{container.2xl}"
      },
      "$description": "Dialog widths: sm for confirmations, md for short forms, lg for longer forms."
    },
    "drawer": {
      "sm": {
        "$value": "{container.2xs}"
      },
      "md": {
        "$value": "{container.md}"
      },
      "$description": "Drawer widths: sm for navigation, md for details and filters."
    },
    "overlay-max": {
      "$value": "{container.sm}",
      "$description": "Max width for tooltips and toasts."
    },
    "scroll-region": {
      "$description": "Max block size for scrollable regions such as tables.",
      "sm": {
        "$value": "{container.xs}"
      },
      "md": {
        "$value": "{container.lg}"
      },
      "lg": {
        "$value": "{container.2xl}"
      }
    },
    "viewport": {
      "block": {
        "$value": "{viewport.block}",
        "$description": "Full viewport height: the app shell's block size."
      }
    },
    "breakpoint": {
      "$description": "Container-query widths. Queries cannot read var(): tests/unit/css.test.ts checks every query length equals one of these.",
      "sm": {
        "$value": "{container.xl}",
        "$description": "Below this PageLayout stacks its nav, main and aside regions."
      },
      "md": {
        "$value": "{container.2xl}",
        "$description": "Below this the app shell's sidebar collapses to a drawer."
      }
    },
    "avatar": {
      "$description": "Avatar diameters.",
      "sm": {
        "$value": "{size.6}"
      },
      "md": {
        "$value": "{size.8}"
      },
      "lg": {
        "$value": "{size.10}"
      }
    },
    "skeleton": {
      "block": {
        "$value": "{container.3xs}",
        "$description": "Default height of a block skeleton (card, chart, image)."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "indicator": {
      "$value": "{radius.xs}",
      "$description": "Checkbox boxes and other small marks."
    },
    "control": {
      "$value": "{radius.md}",
      "$description": "Buttons, inputs, selects."
    },
    "surface": {
      "$value": "{radius.lg}",
      "$description": "Cards, tables, dialogs, popovers."
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badges and pills."
    }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "default": {
        "$value": "{border-width.1}",
        "$description": "Hairline borders on controls and surfaces."
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "ring": {
      "width": {
        "$value": "{border-width.2}",
        "$description": "Thickness of the focus outline."
      },
      "offset": {
        "$value": "{space.half}",
        "$description": "Gap between an element and its focus outline."
      }
    }
  }
}
