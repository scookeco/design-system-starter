        "bg": {
          "$value": "{color.amber.50}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.amber.950}"
            }
          }
        },
        "border": {
          "$value": "{color.amber.300}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.amber.800}"
            }
          }
        }
      },
      "danger": {
        "fg": {
          "$value": "{color.red.700}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.red.300}"
            }
          }
        },
        "bg": {
          "$value": "{color.red.50}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.red.950}"
            }
          }
        },
        "border": {
          "$value": "{color.red.300}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.red.800}"
            }
          }
        }
      },
      "info": {
        "fg": {
          "$value": "{color.sky.800}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.sky.300}"
            }
          }
        },
        "bg": {
          "$value": "{color.sky.50}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.sky.950}"
            }
          }
        },
        "border": {
          "$value": "{color.sky.300}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.sky.800}"
            }
          }
        }
      },
      "neutral": {
        "fg": {
          "$value": "{color.gray.700}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.gray.300}"
            }
          }
        },
        "bg": {
          "$value": "{color.gray.100}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.gray.800}"
            }
          }
        },
        "border": {
          "$value": "{color.gray.300}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.gray.600}"
            }
          }
        }
      }
    },
    "focus": {
      "$value": "{color.indigo.600}",
      "$extensions": {
        "starter.modes": {
          "dark": "{color.indigo.300}"
        }
      },
      "$description": "Focus ring. Must meet 3:1 against every surface."
    }
  }
}
