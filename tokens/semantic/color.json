        "fg": {
          "$value": "{color.green.700}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.green.300}"
            }
          }
        },
        "bg": {
          "$value": "{color.green.50}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.green.950}"
            }
          }
        },
        "border": {
          "$value": "{color.green.300}",
          "$extensions": {
            "starter.modes": {
              "dark": "{color.green.800}"
            }
          }
        }
