{
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "{color.black-alpha.10}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Resting surfaces on the canvas: cards, tables."
    },
    "popover": {
      "$value": [
        {
          "color": "{color.black-alpha.10}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": -1,
            "unit": "px"
          }
        },
        {
          "color": "{color.black-alpha.10}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": -2,
            "unit": "px"
          }
        }
      ],
      "$description": "Menus, selects, tooltips: floats above the page, closes on its own."
    },
    "modal": {
      "$value": [
        {
          "color": "{color.black-alpha.20}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 20,
            "unit": "px"
          },
          "blur": {
            "value": 25,
            "unit": "px"
          },
          "spread": {
            "value": -5,
            "unit": "px"
          }
        },
        {
          "color": "{color.black-alpha.10}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 8,
            "unit": "px"
          },
          "blur": {
            "value": 10,
            "unit": "px"
          },
          "spread": {
            "value": -6,
            "unit": "px"
          }
        }
      ],
      "$description": "Dialogs and drawers above the scrim."
    }
  },
  "motion": {
    "$type": "duration",
    "$description": "Durations. Collapse to 0ms under prefers-reduced-motion.",
    "fast": {
      "$value": "{duration.100}",
      "$extensions": {
        "starter.modes": {
          "reduced-motion": "{duration.0}"
        }
      },
      "$description": "Hover and press feedback, colour changes."
    },
    "base": {
      "$value": "{duration.200}",
      "$extensions": {
        "starter.modes": {
          "reduced-motion": "{duration.0}"
        }
      },
      "$description": "Small moves: menus and popovers opening."
    },
    "slow": {
      "$value": "{duration.300}",
      "$extensions": {
        "starter.modes": {
          "reduced-motion": "{duration.0}"
        }
      },
      "$description": "Larger moves: dialogs, drawers, toasts entering."
    },
    "spin": {
      "$value": "{duration.1000}",
      "$description": "One revolution of a loading spinner. Not reduced: the spinner is the only progress cue."
    },
    "pulse": {
      "$value": "{duration.1000}",
      "$extensions": {
        "starter.modes": {
          "reduced-motion": "{duration.0}"
        }
      },
      "$description": "One half-cycle of the skeleton pulse. Stops under reduced motion: skeletons don't need to move to read as loading."
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": "{easing.standard}",
      "$description": "Movement within the page."
    },
    "enter": {
      "$value": "{easing.decelerate}",
      "$description": "Things arriving: decelerates into place."
    },
    "exit": {
      "$value": "{easing.accelerate}",
      "$description": "Things leaving: accelerates away."
    },
    "linear": {
      "$value": "{easing.linear}",
      "$description": "Continuous loops only: spinners, pulses."
    }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking order. Never write a raw z-index.",
    "base": {
      "$value": "{layer.0}",
      "$description": "Content in normal flow."
    },
    "sticky": {
      "$value": "{layer.1}",
      "$description": "Sticky parts of a scroll container: table header rows, action bars. Above content, below anything that floats."
    },
    "dropdown": {
      "$value": "{layer.2}",
      "$description": "Panels anchored to a trigger that close on their own: menus, selects, popovers, hover cards."
    },
    "overlay": {
      "$value": "{layer.3}",
      "$description": "Layers over part of the page that aren’t modal: the skip link as it appears, an Imposter’s overlay (inside the Imposter’s own stacking context)."
    },
    "modal": {
      "$value": "{layer.4}",
      "$description": "Modal dialogs and drawers with their scrim. Everything below is inert while one is open."
    },
    "toast": {
      "$value": "{layer.5}",
      "$description": "Toasts, above modals, so a confirmation sent from inside a dialog stays visible."
    },
    "tooltip": {
      "$value": "{layer.6}",
      "$description": "Tooltips, above everything: they label whatever has focus or the pointer, wherever it is."
    }
  },
  "icon": {
    "stroke": {
      "$type": "number",
      "$value": "{stroke.regular}",
      "$description": "Stroke width for the system icon set."
    }
  }
}
