{
  "name": "design-system-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --ci",
    "dev:app": "vite --config vite.app.config.ts",
    "tokens": "node scripts/build-tokens.ts && node scripts/token-usage.ts",
    "tokens:check": "node scripts/build-tokens.ts --check && node scripts/token-usage.ts --check",
    "manifest": "node scripts/manifest.ts",
    "regen": "npm run tokens && npm run manifest",
    "manifest:check": "node scripts/manifest.ts --check",
    "build": "vite build",
    "build:app": "vite build --config vite.app.config.ts",
    "preview:app": "vite preview --config vite.app.config.ts",
    "size": "size-limit && node scripts/check-tree-shaking.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "test:rules": "node scripts/test-rules.ts",
    "dead-modules": "node scripts/dead-modules.ts",
    "check": "node scripts/check.ts",
    "validate": "npm run check && npm run test:visual:changed",
    "build-storybook": "storybook build --quiet",
    "test:visual": "npm run build-storybook && playwright test",
    "test:visual:update": "npm run build-storybook && playwright test --grep @visual --update-snapshots=changed",
    "test:wcag22": "npm run build-storybook && playwright test --grep @wcag22",
    "test:visual:changed": "node scripts/test-visual-changed.ts",
    "test:visual:docker": "node scripts/visual-docker.ts",
    "test:visual:canonical": "node scripts/visual-docker.ts",
    "test:stories": "vitest run --config vitest.storybook.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/esbuild": "^14.0.1",
    "@size-limit/file": "^14.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "size-limit": "^14.0.1",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.5.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "description": "Design system starter where design-system drift fails the build.",
  "msw": {
    "workerDirectory": [
      ".storybook/public",
      "public"
    ]
  }
}
