# Generated by npm run regen (tokens, token usage, the manifest and the llms files): never edited by
# hand, collapsed in pull request diffs. On a merge conflict in any of them, take either side and run
# npm run regen; the check job fails if they are stale.
design-system.manifest.json linguist-generated=true
llms.txt linguist-generated=true
llms-full.txt linguist-generated=true
src/styles/tokens.css linguist-generated=true
src/tokens/tokens.ts linguist-generated=true
src/tokens/token-usage.json linguist-generated=true
# Visual baselines: binary, and generated in the CI image (npm run test:visual:docker).
tests/visual/__screenshots__/** binary linguist-generated=true
